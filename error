stages:
- stage: DeployToDellNativeEdge
  displayName: 'Deploy Blueprint: Dell NativeEdge Orchestrator'
  jobs:
    - job: DeployBlueprint
      displayName: 'Trigger Blueprint Deployment'
      steps:
        - checkout: none

        - script: |
            set -euo pipefail

            echo "===[ Debugging: Environment & Network Info ]==="
            uname -a
            echo "Running as user: $(whoami)"
            echo "Current Build Number: $BUILD_BUILDNUMBER"
            ip addr || ifconfig || true
            cat /etc/resolv.conf || true
            ping -c 3 ne-orch.platform.dev.catos.internal.cat.com || echo "Ping failed (ICMP not always allowed)"
            echo "===[ End Debug Info ]==="

            echo "===[ Debug: Testing curl connectivity to Orchestrator API for token retrieval... ]==="
            curl -k -v --connect-timeout 15 --max-time 20 --head "$NE_TOKEN_URL" || echo "HEAD request failed"
            curl -k -v --connect-timeout 15 --max-time 20 "$NE_TOKEN_URL" || echo "GET request failed"
            echo "===[ End curl connectivity test ]==="

            echo "===[ Requesting API token from Dell NativeEdge Orchestrator (form-encoded)... ]==="
            token_response=$(curl -k -v --connect-timeout 30 --max-time 40 --location --silent \
              --header 'Content-Type: multipart/form-data' \
              --form "client_id=$NE_CLIENT_ID" \
              --form "client_secret=$NE_SECRET_ID" \
              --form "grant_type=client_credentials" \
              "$NE_TOKEN_URL" 2>&1)
            echo "Full token response:"
            echo "$token_response"

            api_token=$(echo "$token_response" | python3 -c "import sys, json; print(json.load(sys.stdin).get('access_token',''))" 2>/dev/null || echo "")

            if [ -z "$api_token" ]; then
              echo "===[ ERROR: Failed to retrieve API token. Full response above. ]==="
              exit 28
            fi

            echo "Acquired API token: [hidden for security]"

            build_number="$BUILD_BUILDNUMBER"
            deployment_name="${DEPLOYMENT_NAME_PREFIX}_${build_number}"
            cluster_number="${CLUSTER_NUMBER_PREFIX}_${build_number}"

            echo "Generating JSON body for deployment using jq..."
            if ! command -v jq >/dev/null 2>&1; then
              echo "jq not found, installing..."
              sudo apt-get update
              sudo apt-get install -y jq
            fi

            jq -n '
              {
                blueprint_id: env.BLUEPRINT_ID,
                name: env.deployment_name,
                inputs: {
                  team_name: env.TEAM_NAME,
                  Node_Instance_Type: env.NODE_INSTANCE_TYPE,
                  Account_Prefix: env.ACCOUNT_PREFIX,
                  Cluster_Number: env.cluster_number,
                  "Admin_Node_Volume_Size (GB)": (env.ADMIN_NODE_VOLUME_SIZE | tonumber),
                  Environment_Suffix: env.ENV_SUFFIX,
                  "Worker_Node_Volume_Size (GB)": (env.WORKER_NODE_VOLUME_SIZE | tonumber),
                  Admin_Instance_Type: env.ADMIN_INSTANCE_TYPE
                },
                tags: [
                  {key: "deployment_team", value: env.TEAM_NAME},
                  {key: "environment", value: env.ENV_SUFFIX},
                  {key: "triggered_by", value: "CatOs-DevOps"},
                  {key: "triggered_on", value: env.build_number}
                ]
              }
            ' > deploy_body.json

            echo "======== Deployment Request Body ========"
            cat deploy_body.json
            echo "========================================"

            echo "Triggering blueprint deployment..."
            response=$(curl -k -v --connect-timeout 60 --max-time 120 --location --show-error \
              --header 'Content-Type: application/json' \
              --header "Authorization: Bearer $api_token" \
              --data @deploy_body.json \
              "$NE_DEPLOY_URL" 2>&1 )

            echo "Dell NativeEdge Deployment API response:"
            echo "$response"

            if echo "$response" | grep -Eiq 'error|fail|unauthorized|invalid|timeout'; then
              echo "Deployment trigger failed. See response above."
              exit 1
            fi

            echo "Deployment triggered successfully."
          displayName: 'Authenticate and Trigger Dell NativeEdge Blueprint Deployment'
          env:
            NE_CLIENT_ID: $(NE_CLIENT_ID)
            NE_SECRET_ID: $(NE_SECRET_ID)
            NE_TOKEN_URL: $(NE_TOKEN_URL)
            NE_DEPLOY_URL: $(NE_DEPLOY_URL)
            ACCOUNT_PREFIX: $(ACCOUNT_PREFIX)
            BLUEPRINT_ID: $(BLUEPRINT_ID)
            TEAM_NAME: ${{ parameters.TeamName }}
            NODE_INSTANCE_TYPE: ${{ parameters.NodeInstanceType }}
            CLUSTER_NUMBER_PREFIX: ${{ parameters.ClusterNumberPrefix }}
            ENV_SUFFIX: ${{ parameters.EnvSuffix }}
            ADMIN_NODE_VOLUME_SIZE: ${{ parameters.AdminNodeVolumeSize }}
            WORKER_NODE_VOLUME_SIZE: ${{ parameters.WorkerNodeVolumeSize }}
            ADMIN_INSTANCE_TYPE: ${{ parameters.AdminInstanceType }}
            DEPLOYMENT_NAME_PREFIX: ${{ parameters.DeploymentNamePrefix }}
            BUILD_BUILDNUMBER: $(Build.BuildNumber)
